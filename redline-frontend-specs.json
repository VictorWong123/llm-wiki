  },
  "components": {
    "Header": "Logo, tagline, top nav links, working search form",
    "SidebarNav": "Left navigation with meaningful links only",
    "WikiBox": "Reusable bordered sidebar/content box with title and children",
    "PreflightResultPanel": "Featured result with status, metadata, matched rule, evidence, and safe rewrite",
    "CodeBlock": "Monospace block with line numbers",
    "RecentViolations": "Small list/table of recent violations",
    "SearchResultsPage": "Displays real filtered search results",
    "SimplePage": "Reusable content page for docs/about/help/etc.",
    "RuleListPage": "Lists rule records and links to detail pages",
    "RuleDetailPage": "Shows real rule info, examples, and tests",
    "PreflightPage": "Interactive preflight form connected to local demo detector or backend if available"
  },
  "interaction_requirements": {
    "search_bar": "Must filter a local searchable dataset and navigate to a search results page.",
    "links": "Every link must use React Router Link or equivalent. No href='#' unless linking to an actual in-page anchor.",
    "preflight_demo": "The New Preflight Check page should accept pasted code/content. If it detects string-concatenated SQL, show REDLINE TRIGGERED using the same visual style. If it detects prompt injection phrases, show REDLINE TRIGGERED for PROMPT-001. Otherwise show PASS.",
    "download_links": "If included, Download HTML and Download JSON should generate actual downloadable files from the current report. Do not include download links if they are not implemented.",
    "rerun_check": "Re-run Check should actually rerun the local preflight detector on the current example."
  },
  "accessibility": {
    "use_semantic_html": true,
    "labels_for_search": true,
    "keyboard_navigation": true,
    "do_not_rely_on_color_only": true,
    "status_text_visible": true
  },
  "implementation_notes": {
    "preferred_stack": "React + TypeScript + Vite + CSS modules or plain CSS",
    "no_ui_framework_required": true,
    "data_source": "Use local TypeScript data arrays first: rules, violations, unsafePatterns, safePatterns, regressionTests. Later wire API.",
    "backend_optional": "If backend exists, make API layer configurable through VITE_API_BASE_URL. If not, local demo data must still work.",
    "responsive": "Desktop-first. For small screens, stack columns: header, left nav, main, right sidebar."
  }
}